# ==============================================================================
# Vault Environment Configuration
# ==============================================================================

# PostgreSQL Connection String (Neon.tech or Supabase Free Tier)
# e.g., postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vault_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"


REDIS_URL=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Server Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
