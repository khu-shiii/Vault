// Prisma schema for Vault - Cryptographic Document Attestation Platform
// Target: PostgreSQL (Neon.tech / Supabase Free Tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SIGNER
  VIEWER
  PUBLIC_VERIFIER
}

enum ActionType {
  UPLOAD
  VIEW
  SIGN
  PERMISSION_UPDATE
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now()) @map("created_at")
  eventMappings  Json            @default("{}") @map("event_mappings")
  users          User[]
  documents      Document[]
  securityEvents SecurityEvent[]
  apiKeys        ApiKey[]
  customers      Customer[]

  @@map("organizations")
}

model User {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           Role            @default(VIEWER)
  createdAt      DateTime        @default(now()) @map("created_at")
  disabledAt     DateTime?       @map("disabled_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  auditActions   AuditLogEntry[]
  securityActed  SecurityEvent[] @relation("SecurityActor")
  securityTarget SecurityEvent[] @relation("SecurityTarget")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Document {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  title          String
  fileHash       String @map("file_hash")
  merkleRoot     String @map("merkle_root")
  fileSize       Int    @map("file_size")

  mimeType  String   @default("application/octet-stream") @map("mime_type")
  metadata  Json     @default("{}") @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  merkleBlocks         MerkleBlock[]
  auditLogEntries      AuditLogEntry[]
  verificationAttempts VerificationAttempt[]
  versions             DocumentVersion[]

  @@index([fileHash], name: "idx_documents_file_hash")
  @@index([merkleRoot], name: "idx_documents_merkle_root")
  @@index([organizationId], name: "idx_documents_org_id")
  @@map("documents")
}

model MerkleBlock {
  id          String  @id @default(uuid())
  documentId  String  @map("document_id")
  blockIndex  Int     @map("block_index")
  blockHash   String  @map("block_hash")
  parentHash  String? @map("parent_hash")
  chunkSize   Int     @default(262144) @map("chunk_size") // 256 KB
  chunkOffset Int     @default(0) @map("chunk_offset")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, blockIndex], name: "uq_doc_block_idx")
  @@index([documentId], name: "idx_merkle_blocks_doc_id")
  @@map("merkle_blocks")
}

model AuditLogEntry {
  id           String     @id @default(uuid())
  documentId   String     @map("document_id")
  seq          Int
  actionType   ActionType @map("action_type")
  actorId      String?    @map("actor_id")
  timestamp    DateTime   @default(now()) @map("timestamp")
  payloadData  Json       @default("{}") @map("payload_data")
  previousHash String     @map("previous_hash")
  currentHash  String     @map("current_hash")

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([documentId, seq], name: "uq_audit_doc_seq")
  @@index([actorId], name: "idx_audit_actor_id")
  @@map("audit_log_entries")
}

model VerificationAttempt {
  id            String   @id @default(uuid())
  documentId    String?  @map("document_id")
  isAuthentic   Boolean  @map("is_authentic")
  fileHash      String   @map("file_hash")
  merkleRoot    String   @map("merkle_root")
  verifiedAt    DateTime @default(now()) @map("verified_at")
  ipAddressHash String?  @map("ip_address_hash")

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([fileHash], name: "idx_verifications_file_hash")
  @@index([merkleRoot], name: "idx_verifications_merkle_root")
  @@map("verification_attempts")
}

// Admin/security operations (user management). Plain log, not hash-chained.
model SecurityEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  targetUserId   String?  @map("target_user_id")
  action         String
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("SecurityActor", fields: [actorId], references: [id], onDelete: SetNull)
  target       User?        @relation("SecurityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt], name: "idx_security_events_org_created")
  @@map("security_events")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  label          String
  prefix         String
  keyHash        String       @unique @map("key_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  revokedAt      DateTime?    @map("revoked_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Customer {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  externalCustomerId String              @map("external_customer_id")
  phone              String?
  email              String?
  consent            Json                @default("{}")
  quietHours         Json?               @map("quiet_hours")
  createdAt          DateTime            @default(now()) @map("created_at")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  anonymousIds       AnonymousIdentity[]
  sdkEvents          SdkEvent[]
  interactions       InteractionEvent[]
  decisions          Decision[]

  @@unique([organizationId, externalCustomerId], map: "uq_customers_org_ext")
  @@map("customers")
}

model AnonymousIdentity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  anonymousId    String   @map("anonymous_id")
  customerId     String   @map("customer_id")
  createdAt      DateTime @default(now()) @map("created_at")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, anonymousId], map: "uq_anon_org_anon")
  @@map("anonymous_identities")
}

model SdkEvent {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  eventId            String    @map("event_id")
  customerId         String?   @map("customer_id")
  externalCustomerId String?   @map("external_customer_id")
  anonymousId        String?   @map("anonymous_id")
  eventName          String    @map("event_name")
  occurredAt         DateTime  @map("occurred_at")
  source             String
  schemaVersion      Int       @map("schema_version")
  properties         Json      @default("{}")
  receivedAt         DateTime  @default(now()) @map("received_at")
  customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, eventId], map: "uq_sdk_events_org_event")
  @@index([organizationId, customerId, occurredAt], map: "idx_sdk_events_customer_time")
  @@index([organizationId, anonymousId], map: "idx_sdk_events_anon")
  @@map("sdk_events")
}

model InteractionEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  interactionId  String?  @map("interaction_id")
  customerId     String   @map("customer_id")
  type           String
  channel        String?
  actionId       String?  @map("action_id")
  status         String?
  payload        Json     @default("{}")
  occurredAt     DateTime @map("occurred_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, interactionId], map: "uq_interactions_org_id")
  @@index([organizationId, customerId, occurredAt], map: "idx_interactions_customer_time")
  @@map("interaction_events")
}

model Decision {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  customerId       String   @map("customer_id")
  triggerEventId   String   @map("trigger_event_id")
  triggerEventName String   @map("trigger_event_name")
  intent           String
  purpose          String
  priority         Int
  halted           Boolean  @default(false)
  plan             Json
  excluded         Json
  gates            Json
  evidence         Json
  createdAt        DateTime @default(now()) @map("created_at")
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actions          Action[]

  @@unique([organizationId, triggerEventId], map: "uq_decisions_org_trigger")
  @@index([organizationId, customerId], map: "idx_decisions_customer")
  @@map("decisions")
}

model Action {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  decisionId     String    @map("decision_id")
  step           Int
  channel        String
  purpose        String
  action         String
  status         String
  dependsOnStep  Int?      @map("depends_on_step")
  notBefore      DateTime? @map("not_before")
  payload        Json
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  mock           Boolean   @default(true)
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  decision       Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, step], map: "idx_actions_decision_step")
  @@map("actions")
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  versionNumber Int      @map("version_number")
  rootHash      String   @map("root_hash")
  leafCount     Int      @map("leaf_count")
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber], name: "uq_doc_version_no")
  @@unique([documentId, rootHash], name: "uq_doc_version_root")
  @@index([rootHash], name: "idx_doc_versions_root")
  @@map("document_versions")
}
